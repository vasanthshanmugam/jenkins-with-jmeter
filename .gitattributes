# Keep line endings stable across Windows and macOS/Linux checkouts.
* text=auto
*.sh       text eol=lf
Jenkinsfile text eol=lf
*Jenkinsfile text eol=lf
*.groovy   text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.properties text eol=lf
*.csv      text eol=lf
*.jmx      text eol=lf
*.java     text eol=lf
*.py       text eol=lf
*.bat      text eol=crlf
*.ps1      text eol=crlf
